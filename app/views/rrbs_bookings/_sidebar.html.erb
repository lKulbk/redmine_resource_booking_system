<br/>

<h2><%= l(:label_rrbs_book_index) %></h2>

<% @rrbs_resources.each do |r| %>

  <%
    resource_events = @events_book.select do |event|
      r_id = event.custom_field_value(
        @rrbs_setting.custom_field_id_room
      )

      r_id.to_i == r[1].to_i
    end
  %>

  <% if resource_events.any? %>

    <div
      class="rrbs-planned-resource"
      data-resource-id="<%= r[1] %>"
    >

      <h3><%= r[0] %></h3>

      <% resource_events.each do |event| %>

        <%= event.assigned_to %>
        <%= event.start_date %> -
        <%= event.due_date %>
        <br/>

      <% end %>

    </div>

  <% end %>

<% end %>

