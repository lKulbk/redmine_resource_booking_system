<script type="text/javascript">
    var baseUrl = "<%= @base_url %>";
    var project_id = "<%= @rrbs_setting.project_id.to_i %>"
    var tracker_id = "<%= @rrbs_setting.tracker_id %>"

	var fieldIdResource = "<%= @rrbs_setting.custom_field_id_room %>";
	var fieldIdText = "<%= @rrbs_setting.custom_field_id_text %>";
	
	var pluginName = "redmine_resource_booking_system";
    
  	var user_is_manager = <%= @user_is_manager %>;
	var user_can_add = <%= @user_can_add %>;
	var user_can_edit = <%= @user_can_edit %>;
	var user_can_delete = <%= @user_can_delete %>;
    
    var redmine_date_format = "<%= Setting.date_format %>".replace(/%Y/g, 'YYYY').replace(/%m/g, 'MM').replace(/%d/g, 'DD').replace(/%b/g, 'MMM').replace(/%B/g, 'MMMM');
    var redmine_time_format = "<%= Setting.time_format %>".replace(/%H/g, 'HH').replace(/%M/g, 'mm').replace(/%I/g, 'hh').replace(/%p/g, 'A');
    
    
    var current_lang = '<%= I18n.locale %>';
	
	
	var langUpdateEvent = "<%= l(:label_rrbs_update_event) %>";
	var langCreateEvent = "<%= l(:label_rrbs_create_event) %>";
	
	var label_rrbs_subject = "<%= l(:label_rrbs_subject) %>";
	var label_rrbs_resource = "<%= l(:label_rrbs_resource) %>";
	var label_rrbs_issueid = "<%= l(:label_rrbs_issueid) %>";
	var label_rrbs_booking_text = "<%= @rrbs_text %>";
	
	var tracker_name = "<%= Tracker.find(@rrbs_setting.tracker_id).name %>";
	var rrbs_resources = <%= raw(@rrbs_resources ) %>;

	var api_key = "<%= @api_key %>";
	var status_name ;
	var project_id =  "<%= @rrbs_setting.project_id %>";
	var issue_status_id_book = "<%= @rrbs_setting.issue_status_id_book.to_i %>";
	var issue_status_id_progress = "<%= @rrbs_setting.issue_status_id_progress.to_i %>";
	var issue_status_id_complete = "<%= @rrbs_setting.issue_status_id_complete.to_i %>";
	var issue_status_id_cancel = "<%= @rrbs_setting.issue_status_id_cancel.to_i %>";
	var tracker_id = "<%= @rrbs_setting.tracker_id %>";
	
</script>



<!-- library 読み込み -->
<%= stylesheet_link_tag 'fullcalendar/fullcalendar.min.css',:plugin => 'redmine_resource_booking_system' %>
<%= stylesheet_link_tag 'fullcalendar/fullcalendar.print.css',:plugin => 'redmine_resource_booking_system',:media => 'print' %>
<%= javascript_include_tag 'fullcalendar/lib/moment.min.js',:plugin => 'redmine_resource_booking_system' %>
<%= javascript_include_tag 'fullcalendar/fullcalendar.min.js',:plugin => 'redmine_resource_booking_system' %>
<%= javascript_include_tag 'fullcalendar/locale-all.js',:plugin => 'redmine_resource_booking_system' %>

<!-- 自作assets 読み込み -->
<%= stylesheet_link_tag 'rrbs_style.css',:plugin => 'redmine_resource_booking_system' %>
<%= javascript_include_tag 'rrbs_calendar.js',:plugin => 'redmine_resource_booking_system' %>


 <% content_for :sidebar do %> 
   <%= render :partial => 'sidebar' %>
 <% end %>

<div id="rrbs_left">
  <div id="rrbs_resource">

    <%
      begin
        rrbs_departments =
          JSON.parse(@rrbs_setting.departments.presence || '{}')
      rescue JSON::ParserError
        rrbs_departments = {}
      end

      grouped_employee_names =
        rrbs_departments.values.flatten.map(&:to_s)

      ungrouped_resources =
        @rrbs_resources.reject do |r|
          grouped_employee_names.include?(r[0].to_s)
        end
    %>

    <div class="rrbs-resource-tree-title">
      Сотрудники
    </div>

    <div class="rrbs-select-all-row">
      <input
        type="checkbox"
        id="rrbs_resource_all"
      >

      <label for="rrbs_resource_all">
        Выбрать всех
      </label>
    </div>


    <% rrbs_departments.each_with_index do |(department_name, employees), department_index| %>

      <%
        department_resources =
          @rrbs_resources.select do |r|
            employees.map(&:to_s).include?(r[0].to_s)
          end

        next if department_resources.empty?

        department_id =
          "rrbs_department_#{department_index}"
      %>

      <div class="rrbs-department">

        <div class="rrbs-department-header">

          <button
            type="button"
            class="rrbs-department-toggle"
            data-target="<%= department_id %>"
            aria-expanded="true"
            title="Свернуть подразделение"
          >
            ▼
          </button>

          <input
            type="checkbox"
            class="rrbs-department-checkbox"
            id="<%= department_id %>_checkbox"
            data-target="<%= department_id %>"
          >

          <label
            for="<%= department_id %>_checkbox"
            class="rrbs-department-name"
          >
            <%= department_name %>
          </label>

        </div>


        <div
          class="rrbs-department-employees"
          id="<%= department_id %>"
        >

          <% department_resources.each do |r| %>

            <div class="rrbs-resource-row">

              <%= check_box_tag(
                    "rrbs_resource_checkbox",
                    r[1],
                    false,
                    {
                      id: "rrbs_resource_checkbox_#{r[1]}",
                      multiple: true,
                      class: "rrbs-employee-checkbox",
                      data: {
                        department: department_id
                      }
                    }
                  )
              %>

              <%= label_tag(
                    "rrbs_resource_checkbox_#{r[1]}",
                    r[0]
                  )
              %>

            </div>

          <% end %>

        </div>

      </div>

    <% end %>


    <% if ungrouped_resources.any? %>

      <div class="rrbs-department">

        <div class="rrbs-department-header">

          <button
            type="button"
            class="rrbs-department-toggle"
            data-target="rrbs_department_other"
            aria-expanded="true"
            title="Свернуть подразделение"
          >
            ▼
          </button>

          <input
            type="checkbox"
            class="rrbs-department-checkbox"
            id="rrbs_department_other_checkbox"
            data-target="rrbs_department_other"
          >

          <label
            for="rrbs_department_other_checkbox"
            class="rrbs-department-name"
          >
            Без подразделения
          </label>

        </div>


        <div
          class="rrbs-department-employees"
          id="rrbs_department_other"
        >

          <% ungrouped_resources.each do |r| %>

            <div class="rrbs-resource-row">

              <%= check_box_tag(
                    "rrbs_resource_checkbox",
                    r[1],
                    false,
                    {
                      id: "rrbs_resource_checkbox_#{r[1]}",
                      multiple: true,
                      class: "rrbs-employee-checkbox",
                      data: {
                        department: "rrbs_department_other"
                      }
                    }
                  )
              %>

              <%= label_tag(
                    "rrbs_resource_checkbox_#{r[1]}",
                    r[0]
                  )
              %>

            </div>

          <% end %>

        </div>

      </div>

    <% end %>

  </div>
</div>

  <div id='rrbs_right'>

<div class="rrbs-year-plan-toolbar">

    <span id="rrbs_year_controls" style="display:none;">

        <button type="button" id="rrbs_prev_year">
            ←
        </button>

        <span id="rrbs_plan_year"></span>

        <button type="button" id="rrbs_next_year">
            →
        </button>

    </span>

</div>

    <div id='calendar'></div>

    <div id='rrbs_month_plan'></div>

    <div id='rrbs_year_plan' style="display:none;"></div>

    <br/>

    <div id='footer_message'>
        <%= textilizable @rrbs_setting.footer_message %>
    </div>

</div>







<!-- イベント編集画面  -->
<div class="rrbs_saveModal">
	<div class="formLayout">
			<%= label_tag(:subject, l(:label_rrbs_subject)) %><%= text_field_tag :subject, "aaa", :maxlength => 255 %><br/>
	
	    <div id="selected_resource_container">
	        <%= label_tag("selected_resource", l(:label_rrbs_resource)) %><%= select_tag "selected_resource", options_for_select(@rrbs_resources) %><br/>
	    </div>
            <%= label_tag("booking_start_date", l(:label_rrbs_start_date)) %><%= date_field("booking", "start_date", :size => 10 ) %><%= calendar_for('booking_start_date') %>          
            
	        <%= label_tag("booking_end_date", l(:label_rrbs_end_date)) %><%= date_field("booking", "end_date", :size => 10 ) %><%= calendar_for('booking_end_date') %>
	        
            <% if @rrbs_text.present? %>
			  <%= label_tag(:booking_text, @rrbs_text) %> <%= text_field_tag("booking_text") %><br/>
		    <% end %>

    </div>
    <%= submit_tag l(:label_rrbs_save), :type => 'button', :id=>"save_booking" %>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<%= submit_tag l(:label_rrbs_delete), :type => 'button', :id=>"delete_booking" %>
    
    
    <%= hidden_field_tag :project_id, @project_id %>
    <%= hidden_field_tag :author_id, @user.id %>
    <%= hidden_field_tag :user_name, @user_name %>
    <%= hidden_field_tag :event_id, '' %>
    <%= hidden_field_tag :issue_id, @issue_id %>
</div>


