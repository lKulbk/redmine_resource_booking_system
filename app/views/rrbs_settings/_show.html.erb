<div id="rrbs_settings">




<%= labelled_form_for :settings, @rrbs_setting,
                             :url => {:controller => 'rrbs_settings',
                             :action => 'edit', :project_id => @project, :tab => 'rrbs_booking',
                             :setting_id => @rrbs_setting.id}, 
                             :html => {:id => 'rrbs_booking' } do |f| %>



  <div class="box tabular">
    
    <% tracker_ids = Tracker.all %>
      <p>
        <%= label_tag('settings[tracker_id]', l(:label_rrbs_setting_tracker_id)) %>
        <%= select_tag('settings[tracker_id]', options_for_select(tracker_ids.collect{|c| [c.name, c.id]}, @rrbs_setting['tracker_id'])) %>
      </p>
    
    <%- if Rails::VERSION::MAJOR >= 4 %>
      <%- custom_fields_issues = CustomField.where(type: 'IssueCustomField') %>
    <%- else %>
      <%- custom_fields_issues = CustomField.find(:all, :conditions => "type = 'IssueCustomField'") %>
    <%- end %>
      <p>
        <%= label_tag('settings[custom_field_id_room]', l(:label_rrbs_setting_custom_field_id_room)) %>
        <%= select_tag('settings[custom_field_id_room]', options_for_select(custom_fields_issues.collect{|c| [c.name, c.id]}, @rrbs_setting['custom_field_id_room'])) %>
        &nbsp This item must be a type of Key-value-list Issue-Customfield.
      </p>
<p>
  <%= label_tag(
        'settings[custom_field_id_department]',
        'Поле "Подразделение"'
      )
  %>

  <%= select_tag(
        'settings[custom_field_id_department]',
        options_for_select(
          custom_fields_issues.collect { |c| [c.name, c.id] },
          @rrbs_setting['custom_field_id_department']
        ),
        include_blank: true
      )
  %>

  &nbsp This item must be a type of Key-value-list Issue-Customfield.
</p>
      <p>
        <%= label_tag('settings[custom_field_id_start]', l(:label_rrbs_setting_custom_field_id_start)) %>
        <%= select_tag('settings[custom_field_id_start]', options_for_select(custom_fields_issues.collect{|c| [c.name, c.id]}, @rrbs_setting['custom_field_id_start'])) %>
        &nbsp This item must be a type of List Issue-Customfield. ex: 09:00 09:15 09:30 (please fill in 0, 9:00 not allowed)
      </p>
      <p>
        <%= label_tag('settings[custom_field_id_end]', l(:label_rrbs_setting_custom_field_id_end)) %>
        <%= select_tag('settings[custom_field_id_end]', options_for_select(custom_fields_issues.collect{|c| [c.name, c.id]}, @rrbs_setting['custom_field_id_end'])) %>
        &nbsp This item must be a type of List Issue-Customfield. ex: 09:00 09:15 09:30 (please fill in 0, 9:00 not allowed)
      </p>
      <p>
        <%= label_tag('settings[custom_field_id_text', l(:label_rrbs_setting_custom_field_id_text)) %>
        <%= select_tag('settings[custom_field_id_text]', options_for_select(custom_fields_issues.collect{|c| [c.name, c.id]}, @rrbs_setting['custom_field_id_text']),include_blank: true) %>
        &nbsp [Optional] This item must be a type of Text Issue-Customfield.
      </p>
    
    
    <p>
      <%= label_tag('settings[footer_message]', l(:label_rrbs_footer_message)) %>
      <%= text_area_tag('settings[footer_message]', @rrbs_setting['footer_message']) %>
      <br/>
    </p>
   <hr>

  <%
  departments_cf = nil
  employees_cf = nil
  department_values = []
  employee_values = []

  if @rrbs_setting.custom_field_id_department.present?
    departments_cf = IssueCustomField.find_by(
      id: @rrbs_setting.custom_field_id_department
    )
  end

  if @rrbs_setting.custom_field_id_room.present?
    employees_cf = IssueCustomField.find_by(
      id: @rrbs_setting.custom_field_id_room
    )
  end

  if departments_cf
    department_values = departments_cf.enumerations.active.to_a
  end

  if employees_cf
    employee_values = employees_cf.enumerations.active.to_a
  end

  begin
    saved_departments =
      JSON.parse(@rrbs_setting.departments.presence || '{}')
  rescue JSON::ParserError
    saved_departments = {}
  end
%>

<hr>

<h3>Связь подразделений и сотрудников</h3>

<% if departments_cf.nil? || employees_cf.nil? %>

  <p>
    Сначала выберите поля "Подразделение" и "Сотрудник",
    сохраните настройки и снова откройте эту страницу.
  </p>

<% else %>

  <%= hidden_field_tag(
        'settings[departments]',
        @rrbs_setting.departments.presence || '{}',
        id: 'rrbs_departments_json'
      )
  %>

  <div id="rrbs_department_editor">

    <% department_values.each do |department| %>

      <fieldset
        class="rrbs-department"
        data-department-id="<%= department.id %>"
        style="margin-bottom: 15px;"
      >

        <legend>
          <strong><%= department.name %></strong>
        </legend>

        <% employee_values.each do |employee| %>

          <%
            selected_employees =
              Array(saved_departments[department.id.to_s])
                .map(&:to_s)

            checked =
              selected_employees.include?(employee.id.to_s)
          %>

          <label
            style="display:block; margin-left:20px;"
          >

            <input
              type="checkbox"
              class="rrbs-department-employee"
              value="<%= employee.id %>"
              <%= 'checked="checked"'.html_safe if checked %>
            >

            <%= employee.name %>

          </label>

        <% end %>

      </fieldset>

    <% end %>

  </div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    var editor =
        document.getElementById('rrbs_department_editor');

    var jsonField =
        document.getElementById('rrbs_departments_json');

    if (!editor || !jsonField) {
        return;
    }

    function rebuildDepartmentsJson() {

        var result = {};

        editor
            .querySelectorAll('.rrbs-department')
            .forEach(function (departmentBlock) {

                var departmentId =
                    String(
                        departmentBlock.dataset.departmentId
                    );

                result[departmentId] = [];

                departmentBlock
                    .querySelectorAll(
                        '.rrbs-department-employee:checked'
                    )
                    .forEach(function (checkbox) {

                        result[departmentId].push(
                            String(checkbox.value)
                        );

                    });

            });

        jsonField.value = JSON.stringify(result);
    }

    editor.addEventListener('change', function (event) {

        if (
            event.target.classList.contains(
                'rrbs-department-employee'
            )
        ) {
            rebuildDepartmentsJson();
        }

    });

    var form =
        document.getElementById('rrbs_booking');

    if (form) {
        form.addEventListener(
            'submit',
            rebuildDepartmentsJson
        );
    }

});
</script>

<% end %>
    
    
    <br/>
    Note:<br/>
    This plugin uses 'issue', 'tracker', 'status' and workflow function, so customization can be done in the redmine original function.<br>
  </div>

    <%= submit_tag l(:button_save) %>
    <% end %>




</div>


